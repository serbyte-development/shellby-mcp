{
  "name": "chatgpt-local-shell-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:restart": "npm run build && pm2 reload ecosystem.config.cjs --update-env",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "inspect": "npx @modelcontextprotocol/inspector",
    "tunnel": "ngrok http 3333 --url=geologic-catalog-deodorant.ngrok-free.dev --traffic-policy-file ./ngrok-traffic-policy.yml",
    "test": "tsx --test test/*.test.ts",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cloakbrowser": "^0.5.5",
    "defuddle": "^0.19.2",
    "express": "^5.2.1",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.8",
    "typescript": "7.0.2"
  }
}
