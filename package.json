{
  "name": "chatgpt-local-shell-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "npm run print-url -- --optional && node dist/index.js",
    "print-url": "node scripts/print-url.mjs",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs && npm run print-url",
    "pm2:restart": "rm -f agent-commands.yaml && npm run build && pm2 reload ecosystem.config.cjs --update-env && npm run print-url",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "inspect": "npx @modelcontextprotocol/inspector",
    "tunnel": "ngrok http 3333 ${NGROK_URL:+--url=\"$NGROK_URL\"} --traffic-policy-file ./ngrok-traffic-policy.yml --inspect=false",
    "auth:reset": "tsx src/auth/reset.ts",
    "test": "tsx --test test/*.test.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "vendor:apply-patch": "scripts/build-apply-patch.sh",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test package.json tsconfig.json eslint.config.js ecosystem.config.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cloakbrowser": "^0.5.6",
    "defuddle": "^0.19.2",
    "express": "^5.2.1",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
