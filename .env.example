# Workspace where new shell sessions start and where Shellby MCP looks for AGENTS.md.
MCP_CWD=~/Desktop/agent-workspace

# Shell executable used for persistent sessions.
MCP_SHELL=/bin/zsh

# Chrome DevTools endpoint used by ChatGPT subagents.
MCP_CHATGPT_CDP_ENDPOINT=http://127.0.0.1:9222

# Optional Chrome profile directory inside the dedicated ChatGPT user-data directory.
# Example: Profile 1. Leave unset to let Chrome choose its normal profile.
# MCP_CHATGPT_PROFILE_DIRECTORY=Profile 1

# Optional ChatGPT Project start URL for new subagent conversations.
# Leave unset to start normal standalone ChatGPT conversations instead.
# MCP_CHATGPT_PROJECT_URL=https://chatgpt.com/g/<project-id>/project

# Optional fixed ngrok domain. Leave unset to use an ngrok-assigned URL.
# NGROK_URL=

# Optional ngrok executable override.
# NGROK_BIN=ngrok

# Optional ngrok auth token when it is not already configured globally.
# NGROK_AUTHTOKEN=

# Optional Chrome executable override for the managed ChatGPT browser.
# CHROME_BIN=

# Allow foreground/global computer actions in the vendored Peekaboo child.
# PEEKABOO_ALLOW_FOREGROUND=1
