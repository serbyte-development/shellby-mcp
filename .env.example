# Workspace where new shell sessions start and where Unhinged Agent looks for AGENTS.md.
MCP_CWD=~/Desktop/agent-workspace

# Shell executable used for persistent sessions.
MCP_SHELL=/bin/zsh

# Default o200k_base tokens returned by shell_run/shell_poll when max_output_tokens is omitted.
MCP_DEFAULT_OUTPUT_TOKENS=1024

# Hard ceiling for a caller-provided max_output_tokens value.
MCP_MAX_OUTPUT_TOKENS=16384

# Maximum live named shell sessions, including the default shell.
MCP_MAX_SHELLS=16

# Hibernate inactive named shells after this many milliseconds. Set 0 to disable idle hibernation.
MCP_SHELL_IDLE_TTL_MS=300000 # 5 minutes

# Keep hibernated cwd + exported environment state for this many milliseconds since last use.
MCP_SHELL_CACHE_TTL_MS=86400000 # 24 hours

# Peekaboo executable name or absolute path used by Computer Use tools.
MCP_PEEKABOO_BIN=peekaboo

# Chrome DevTools endpoint used by ChatGPT subagents.
MCP_CHATGPT_CDP_ENDPOINT=http://127.0.0.1:9222

# Optional fixed ngrok domain. Leave unset to use an ngrok-assigned URL.
# NGROK_URL=

# Optional ngrok executable override.
# NGROK_BIN=ngrok

# Optional ngrok auth token when it is not already configured globally.
# NGROK_AUTHTOKEN=

# Optional Chrome executable override for the managed ChatGPT browser.
# CHROME_BIN=
