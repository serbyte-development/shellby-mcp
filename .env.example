# Address the MCP HTTP server binds to.
HOST=127.0.0.1

# MCP HTTP port. The checked-in ngrok helper/policy also assumes 3333.
PORT=3333

# Workspace where new shell sessions start and where Shelly looks for AGENTS.md.
MCP_CWD=~/Desktop/chatgpt-workspace

# Shell executable used for persistent sessions.
MCP_SHELL=/bin/zsh

# Default UTF-8 bytes returned by shell_run/shell_poll when max_output_bytes is omitted.
MCP_DEFAULT_OUTPUT_BYTES=4096

# Hard ceiling for a caller-provided max_output_bytes value.
MCP_MAX_OUTPUT_BYTES=65536

# Maximum live named shell sessions, including the default shell.
MCP_MAX_SHELLS=8

# Close inactive named shells after this many milliseconds. Set 0 to disable cleanup.
MCP_SHELL_IDLE_TTL_MS=1800000 # 30 minutes

# Peekaboo executable name or absolute path used by Computer Use tools.
MCP_PEEKABOO_BIN=peekaboo

# Chrome DevTools endpoint used by ChatGPT subagents.
MCP_CHATGPT_CDP_ENDPOINT=http://127.0.0.1:9222

# Optional fixed ngrok domain. Leave unset to use an ngrok-assigned URL.
# NGROK_URL=

# Optional ngrok executable override.
# NGROK_BIN=ngrok

# Optional ngrok auth token when it is not already configured globally.
# NGROK_AUTHTOKEN=

# Optional Chrome executable override for the managed ChatGPT browser.
# CHROME_BIN=
